# PostgreSQL connection
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Optional direct connection for migrations when using a pooler
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Required session-signing secret; use a long random value
CRM_SESSION_SECRET="replace-with-a-long-random-secret"

# Optional bootstrap super-admin credentials; never commit real values
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
