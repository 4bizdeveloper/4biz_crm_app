              >
                {loading ? (
                  <span>Signing in...</span>
                ) : (
                  <>
                    <span>Sign In to Dashboard</span>
                    <ArrowRight className="w-4 h-4" />
                  </>
                )}
              </button>
            </form>

            <div className="pt-4 text-center">
              <p className="text-xs text-slate-400">
                Encrypted with SSL 256-bit authentication
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  );
}
