    return keys.map((key, idx) => ({
      label: key,
      value: stats.leadsByStatus[key],
      color: palette[idx % palette.length],
    }));
  }, [stats.leadsByStatus]);

  const projectStatusList = ['Planning', 'In Progress', 'Testing', 'On Hold', 'Completed'];

