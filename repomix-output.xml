              >
                Close View
              </button>
            </div>
          </div>
        </div>
      )}

      {/* TAB 1: Detailed Enquiry Table */}
      {activeTab === 'details' && (
        <div className="bg-white rounded-3xl border border-slate-200/80 shadow-xs overflow-hidden">
