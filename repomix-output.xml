            <div>
              <label className="text-xs font-semibold text-slate-600 block mb-1">Contact Details (Phone / Email / Address)</label>
              <textarea
                rows={3}
                required
                placeholder={"+1 (555) 000-0000\nemail@company.com\n123 Business St, Suite 100"}
